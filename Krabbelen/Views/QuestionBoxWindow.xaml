<Window x:Class="Krabbelen.Views.QuestionBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Krabbelen.Views"
        mc:Ignorable="d"
        Title="QuestionBoxWindow" 
				Height="82" 
				Width="300"
				KeyUp="Window_KeyUp">
	
	<Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<TextBlock
			Grid.Column="0"
			Height="Auto"
			Margin="0 0 10 0"
			Text="Question: "/>

		<TextBox
			Grid.Column="1"
			Height="Auto"
			Text=""
			Name="Answer" RenderTransformOrigin="0.5,0.5">
			<TextBox.RenderTransform>
				<TransformGroup>
					<ScaleTransform/>
					<SkewTransform AngleX="-0.137"/>
					<RotateTransform/>
					<TranslateTransform X="-0.497"/>
				</TransformGroup>
			</TextBox.RenderTransform>
		</TextBox>
	</Grid>
</Window>
